{
  "name": "e-commerce-order-inventory-api",
  "version": "1.0.0",
  "private": true,
  "description": "Single-service order and inventory API with PostgreSQL and Redis.",
  "scripts": {
    "start": "node app.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "load": "node load-test/run.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/setup-env.js"],
    "testMatch": ["<rootDir>/tests/**/*.test.js"],
    "collectCoverageFrom": ["app.js"]
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
